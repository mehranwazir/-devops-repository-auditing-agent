{"timestamp": "2026-10-15T23:46:28.298680+00:00", "event": "tool_result", "turn": 5, "name": "read_file", "result": {"path": "src/markupsafe/__init__.py", "lines": [{"line": 1, "text": "from __future__ import annotations"}, {"line": 2, "text": ""}, {"line": 3, "text": "import collections.abc as cabc"}, {"line": 4, "text": "import string"}, {"line": 5, "text": "import typing as t"}, {"line": 6, "text": ""}, {"line": 7, "text": "try:"}, {"line": 8, "text": "    from ._speedups import _escape_inner"}, {"line": 9, "text": "except ImportError:"}, {"line": 10, "text": "    from ._native import _escape_inner"}, {"line": 11, "text": ""}, {"line": 12, "text": "if t.TYPE_CHECKING:"}, {"line": 13, "text": "    import typing_extensions as te"}, {"line": 14, "text": ""}, {"line": 15, "text": ""}, {"line": 16, "text": "class _HasHTML(t.Protocol):"}, {"line": 17, "text": "    def __html__(self, /) -> str: ..."}, {"line": 18, "text": ""}, {"line": 19, "text": ""}, {"line": 20, "text": "class _TPEscape(t.Protocol):"}, {"line": 21, "text": "    def __call__(self, s: t.Any, /) -> Markup: ..."}, {"line": 22, "text": ""}, {"line": 23, "text": ""}, {"line": 24, "text": "def escape(s: t.Any, /) -> Markup:"}, {"line": 25, "text": "    \"\"\"Replace the characters ``&``, ``<``, ``>``, ``'``, and ``\"`` in"}, {"line": 26, "text": "    the string with HTML-safe sequences. Use this if you need to display"}, {"line": 27, "text": "    text that might contain such characters in HTML."}, {"line": 28, "text": ""}, {"line": 29, "text": "    If the object has an ``__html__`` method, it is called and the"}, {"line": 30, "text": "    return value is assumed to already be safe for HTML."}, {"line": 31, "text": ""}, {"line": 32, "text": "    :param s: An object to be converted to a string and escaped."}, {"line": 33, "text": "    :return: A :class:`Markup` string with the escaped text."}, {"line": 34, "text": "    \"\"\""}, {"line": 35, "text": "    # If the object is already a plain string, skip __html__ check and string"}, {"line": 36, "text": "    # conversion. This is the most common use case."}, {"line": 37, "text": "    # Use type(s) instead of s.__class__ because a proxy object may be reporting"}, {"line": 38, "text": "    # the __class__ of the proxied value."}, {"line": 39, "text": "    if type(s) is str:"}, {"line": 40, "text": "        return Markup(_escape_inner(s))"}, {"line": 41, "text": ""}, {"line": 42, "text": "    if hasattr(s, \"__html__\"):"}, {"line": 43, "text": "        return Markup(s.__html__())"}, {"line": 44, "text": ""}, {"line": 45, "text": "    return Markup(_escape_inner(str(s)))"}, {"line": 46, "text": ""}, {"line": 47, "text": ""}, {"line": 48, "text": "def escape_silent(s: t.Any | None, /) -> Markup:"}, {"line": 49, "text": "    \"\"\"Like :func:`escape` but treats ``None`` as the empty string."}, {"line": 50, "text": "    Useful with optional values, as otherwise you get the string"}, {"line": 51, "text": "    ``'None'`` when the value is ``None``."}, {"line": 52, "text": ""}, {"line": 53, "text": "    >>> escape(None)"}, {"line": 54, "text": "    Markup('None')"}, {"line": 55, "text": "    >>> escape_silent(None)"}, {"line": 56, "text": "    Markup('')"}, {"line": 57, "text": "    \"\"\""}, {"line": 58, "text": "    if s is None:"}, {"line": 59, "text": "        return Markup()"}, {"line": 60, "text": ""}, {"line": 61, "text": "    return escape(s)"}, {"line": 62, "text": ""}, {"line": 63, "text": ""}, {"line": 64, "text": "def soft_str(s: t.Any, /) -> str:"}, {"line": 65, "text": "    \"\"\"Convert an object to a string if it isn't already. This preserves"}, {"line": 66, "text": "    a :class:`Markup` string rather than converting it back to a basic"}, {"line": 67, "text": "    string, so it will still be marked as safe and won't be escaped"}, {"line": 68, "text": "    again."}, {"line": 69, "text": ""}, {"line": 70, "text": "    >>> value = escape(\"<User 1>\")"}, {"line": 71, "text": "    >>> value"}, {"line": 72, "text": "    Markup('&lt;User 1&gt;')"}, {"line": 73, "text": "    >>> escape(str(value))"}, {"line": 74, "text": "    Markup('&amp;lt;User 1&amp;gt;')"}, {"line": 75, "text": "    >>> escape(soft_str(value))"}, {"line": 76, "text": "    Markup('&lt;User 1&gt;')"}, {"line": 77, "text": "    \"\"\""}, {"line": 78, "text": "    if not isinstance(s, str):"}, {"line": 79, "text": "        return str(s)"}, {"line": 80, "text": ""}, {"line": 81, "text": "    return s"}, {"line": 82, "text": ""}, {"line": 83, "text": ""}, {"line": 84, "text": "class Markup(str):"}, {"line": 85, "text": "    \"\"\"A string that is ready to be safely inserted into an HTML or XML"}, {"line": 86, "text": "    document, either because it was escaped or because it was marked"}, {"line": 87, "text": "    safe."}, {"line": 88, "text": ""}, {"line": 89, "text": "    Passing an object to the constructor converts it to text and wraps"}, {"line": 90, "text": "    it to mark it safe without escaping. To escape the text, use the"}, {"line": 91, "text": "    :meth:`escape` class method instead."}, {"line": 92, "text": ""}, {"line": 93, "text": "    >>> Markup(\"Hello, <em>World</em>!\")"}, {"line": 94, "text": "    Markup('Hello, <em>World</em>!')"}, {"line": 95, "text": "    >>> Markup(42)"}, {"line": 96, "text": "    Markup('42')"}, {"line": 97, "text": "    >>> Markup.escape(\"Hello, <em>World</em>!\")"}, {"line": 98, "text": "    Markup('Hello &lt;em&gt;World&lt;/em&gt;!')"}, {"line": 99, "text": ""}, {"line": 100, "text": "    This implements the ``__html__()`` interface that some frameworks"}, {"line": 101, "text": "    use. Passing an object that implements ``__html__()`` will wrap the"}, {"line": 102, "text": "    output of that method, marking it safe."}, {"line": 103, "text": ""}, {"line": 104, "text": "    >>> class Foo:"}, {"line": 105, "text": "    ...     def __html__(self):"}, {"line": 106, "text": "    ...         return '<a href=\"/foo\">foo</a>'"}, {"line": 107, "text": "    ..."}, {"line": 108, "text": "    >>> Markup(Foo())"}, {"line": 109, "text": "    Markup('<a href=\"/foo\">foo</a>')"}, {"line": 110, "text": ""}, {"line": 111, "text": "    This is a subclass of :class:`str`. It has the same methods, but"}, {"line": 112, "text": "    escapes their arguments and returns a ``Markup`` instance."}, {"line": 113, "text": ""}, {"line": 114, "text": "    >>> Markup(\"<em>%s</em>\") % (\"foo & bar\",)"}, {"line": 115, "text": "    Markup('<em>foo &amp; bar</em>')"}, {"line": 116, "text": "    >>> Markup(\"<em>Hello</em> \") + \"<foo>\""}, {"line": 117, "text": "    Markup('<em>Hello</em> &lt;foo&gt;')"}, {"line": 118, "text": "    \"\"\""}, {"line": 119, "text": ""}, {"line": 120, "text": "    __slots__ = ()"}, {"line": 121, "text": ""}, {"line": 122, "text": "    def __new__("}, {"line": 123, "text": "        cls, object: t.Any = \"\", encoding: str | None = None, errors: str = \"strict\""}, {"line": 124, "text": "    ) -> te.Self:"}, {"line": 125, "text": "        if hasattr(object, \"__html__\"):"}, {"line": 126, "text": "            object = object.__html__()"}, {"line": 127, "text": ""}, {"line": 128, "text": "        if encoding is None:"}, {"line": 129, "text": "            return super().__new__(cls, object)"}, {"line": 130, "text": ""}, {"line": 131, "text": "        return super().__new__(cls, object, encoding, errors)"}, {"line": 132, "text": ""}, {"line": 133, "text": "    def __html__(self, /) -> te.Self:"}, {"line": 134, "text": "        return self"}, {"line": 135, "text": ""}, {"line": 136, "text": "    def __add__(self, value: str | _HasHTML, /) -> te.Self:"}, {"line": 137, "text": "        if isinstance(value, str) or hasattr(value, \"__html__\"):"}, {"line": 138, "text": "            return self.__class__(super().__add__(self.escape(value)))"}, {"line": 139, "text": ""}, {"line": 140, "text": "        return NotImplemented"}, {"line": 141, "text": ""}, {"line": 142, "text": "    def __radd__(self, value: str | _HasHTML, /) -> te.Self:"}, {"line": 143, "text": "        if isinstance(value, str) or hasattr(value, \"__html__\"):"}, {"line": 144, "text": "            return self.escape(value).__add__(self)"}, {"line": 145, "text": ""}, {"line": 146, "text": "        return NotImplemented"}, {"line": 147, "text": ""}, {"line": 148, "text": "    def __mul__(self, value: t.SupportsIndex, /) -> te.Self:"}, {"line": 149, "text": "        return self.__class__(super().__mul__(value))"}, {"line": 150, "text": ""}], "total_lines": 389, "next_line": 151, "redactions": []}}
